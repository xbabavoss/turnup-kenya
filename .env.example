DEBUG=False
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
SITE_URL=http://127.0.0.1:8000
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000

# Railway sets DATABASE_URL automatically when Postgres is linked.
# DATABASE_URL=postgres://user:pass@host:5432/railway

DB_ENGINE=sqlite
DB_NAME=ticketing
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Email — use Resend on Railway (SMTP ports are often blocked from cloud hosts)
# Sign up: https://resend.com — verify turnupkenya.top, then use tickets@turnupkenya.top
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Turn Up Kenya <tickets@turnupkenya.top>

# Optional SMTP fallback (works locally; often times out on Railway)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=tickets@turnupkenya.top
ADMIN_EMAIL=tickets@turnupkenya.top

# SparkPesa (M-Pesa STK) — https://www.sparkpesa.io/developers
SPARKPESA_API_KEY=your-api-key
SPARKPESA_API_SECRET=your-api-secret
SPARKPESA_WALLET_CODE=12345678
SPARKPESA_WALLET_ID=
SPARKPESA_BASE_URL=https://www.sparkpesa.io/api/v1
SPARKPESA_WEBHOOK_URL=
SPARKPESA_CALLBACK_URL=https://yourdomain.com/webhooks/sparkpesa/
