# Copy these into Railway service variables (Dashboard → Variables).
# Railway auto-injects DATABASE_URL when you add a PostgreSQL plugin.

DEBUG=False
SECRET_KEY=generate-a-long-random-secret-key

# Portal admin (created on deploy if user does not exist)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-this-strong-password
DJANGO_SUPERUSER_EMAIL=admin@turnupkenya.top

# Set after first deploy (Railway → Settings → Networking → public domain)
SITE_URL=https://your-app.up.railway.app
ALLOWED_HOSTS=your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# Or leave SITE_URL empty and set RAILWAY_PUBLIC_DOMAIN (auto on Railway)
# RAILWAY_PUBLIC_DOMAIN=your-app.up.railway.app

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=das126.truehost.cloud
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=info@turnupkenya.top
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=info@turnupkenya.top
ADMIN_EMAIL=info@turnupkenya.top

# SparkPesa — callback defaults to {SITE_URL}/webhooks/sparkpesa/
SPARKPESA_API_KEY=
SPARKPESA_API_SECRET=
SPARKPESA_WALLET_CODE=
SPARKPESA_BASE_URL=https://www.sparkpesa.io/api/v1
SPARKPESA_WEBHOOK_URL=
SPARKPESA_CALLBACK_URL=

# Optional production toggles
SECURE_SSL_REDIRECT=True
